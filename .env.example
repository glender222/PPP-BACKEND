# Entorno
NODE_ENV=development
PORT=3000

# Base de datos (valores de desarrollo; ver docker-compose.yml)
DATABASE_URL=postgresql://ppp:ppp_dev_password@localhost:5433/ppp_dev?schema=public

# CORS: "*" (todo origen) o lista separada por comas
CORS_ORIGINS=*

# Nivel de log estructurado (pino)
LOG_LEVEL=info

# Documentación interactiva Scalar/OpenAPI
ENABLE_API_DOCS=true

# Autenticación (solo proveedor de desarrollo implementado; prohibido en producción)
AUTH_PROVIDER=dev
APP_JWT_SECRET=dev-only-jwt-secret-change-me
APP_JWT_TTL=8h
DEV_AUTH_PASSWORD=PppDev!2026
